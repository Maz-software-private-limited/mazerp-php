<?php
/**
 * SMTP credentials for contact form email.
 *
 * DEPLOYMENT (one-time on production server):
 * 1. Copy this file to mail-config.local.php in the same directory:
 *    cp mail-config.local.php.example mail-config.local.php
 * 2. Fill in SMTP settings from your hosting panel (Hostinger, cPanel, etc.)
 * 3. Set test_mail_key to a long random string for api/test-mail.php diagnostics
 * 4. Upload mail-config.local.php to includes/ on the server (never commit it)
 */
return [
    'smtp_host'     => 'smtp.hostinger.com',
    'smtp_port'     => 465,
    'smtp_secure'   => 'ssl',                   // use 'ssl' for port 465, 'tls' for 587
    'smtp_user'     => 'support@maztechno.com',
    'smtp_pass'     => 'YOUR_MAILBOX_PASSWORD',
    'from_email'    => 'info@maztechno.com',
    'from_name'     => 'MazERP Website',
    'test_mail_key' => 'generate-a-long-random-string-here',
];
